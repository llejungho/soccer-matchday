{
  "name": "matchday-team-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build-cloudflare.mjs",
    "cf:dev": "wrangler pages dev dist",
    "cf:deploy": "npm run build && wrangler pages deploy dist --project-name soccer-matchday --branch main",
    "db:export": "node scripts/export-d1.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "^4.149.0"
  }
}
